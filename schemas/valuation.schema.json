{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ValuationExpectations",
  "type": "object",
  "required": ["ticker", "as_of", "current_price", "implied_expectations", "scenarios", "expectation_gap_score", "asymmetry_score"],
  "properties": {
    "ticker": {"type": "string"},
    "as_of": {"type": "string", "format": "date"},
    "current_price": {"type": "number", "exclusiveMinimum": 0},
    "implied_expectations": {"type": "object"},
    "scenarios": {
      "type": "object",
      "required": ["bear", "base", "bull"],
      "properties": {
        "bear": {"type": "object"},
        "base": {"type": "object"},
        "bull": {"type": "object"}
      }
    },
    "permanent_loss_case": {"type": ["object", "null"]},
    "expectation_gap_score": {"type": "number", "minimum": 0, "maximum": 15},
    "asymmetry_score": {"type": "number", "minimum": 0, "maximum": 10},
    "subjective_probabilities": {"type": ["object", "null"]},
    "notes": {"type": ["string", "null"]}
  },
  "additionalProperties": false
}
