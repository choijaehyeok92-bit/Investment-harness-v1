{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DisruptiveInnovationAxis",
  "description": "Additive 20-point axis scored outside the 100-point scorecard. See policy/disruption-axis.yaml.",
  "type": "object",
  "required": ["schema_version", "ticker", "as_of", "dimensions", "total", "tier", "falsifiers"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "ticker": {"type": "string", "minLength": 1},
    "as_of": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "dimensions": {
      "type": "object",
      "minProperties": 5,
      "maxProperties": 5,
      "required": [
        "non_consumption_and_new_market_creation",
        "incumbent_business_model_conflict",
        "cost_or_performance_curve",
        "s_curve_position_and_adoption_evidence",
        "platform_optionality_and_second_curve"
      ],
      "additionalProperties": {"$ref": "#/$defs/dimension"}
    },
    "total": {"type": ["number", "null"], "minimum": 0, "maximum": 20},
    "tier": {"enum": ["FOUNDATIONAL", "STRONG", "EMERGING", "INCREMENTAL", "NONE", "UNSCORED"]},
    "falsifiers": {"type": "array", "minItems": 3, "items": {"type": "string", "minLength": 1}},
    "self_funded": {"type": ["boolean", "null"]},
    "funding_runway_months": {"type": ["number", "null"], "minimum": 0},
    "narrative_claims_excluded": {"type": "array", "items": {"type": "string"}},
    "notes": {"type": ["string", "null"]}
  },
  "additionalProperties": false,
  "$defs": {
    "dimension": {
      "type": "object",
      "required": ["score", "max_score", "evidence", "counter_evidence", "confidence", "missing_data"],
      "properties": {
        "score": {"type": ["number", "null"], "minimum": 0, "maximum": 4},
        "max_score": {"const": 4},
        "evidence": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "counter_evidence": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "missing_data": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    }
  }
}
