{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HardVetoReport",
  "type": "object",
  "required": ["ticker", "as_of", "overall_status", "vetoes"],
  "properties": {
    "ticker": {"type": "string"},
    "as_of": {"type": "string", "format": "date"},
    "overall_status": {"enum": ["PASS", "INVESTIGATE", "FAIL"]},
    "vetoes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "status", "evidence", "severity", "confidence", "resolution_needed"],
        "properties": {
          "id": {"type": "string"},
          "status": {"enum": ["PASS", "INVESTIGATE", "FAIL"]},
          "evidence": {"type": "array", "items": {"type": "string"}},
          "severity": {"enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"]},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "resolution_needed": {"type": ["string", "null"]}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
